# Скопируй в .env и заполни значения
# cp .env.example .env

DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=

APP_URL=https://your-domain.com
APP_ENV=production

# Конвертация в WebP (на InfinityFree лучше оставить 0 — сохраняется оригинальный JPG/PNG)
MF_USE_WEBP=0

# Абсолютный путь к uploads/ (если PHP пишет не туда — укажите путь из File Manager)
# UPLOADS_DIR=/home/volXXX/htdocs/uploads

MAIL_FROM=noreply@your-domain.com
MAIL_FROM_NAME=Mendflow

# Показывать код подтверждения на экране (1 = да). Полезно, если почта на сервере
# не настроена (напр. InfinityFree). При настроенном Resend/SMTP оставьте 0.
MAIL_SHOW_CODE=0

# Пытаться отправлять письма через PHP mail() без Resend/SMTP (1 = да).
# На InfinityFree mail() ненадёжна и может «вешать» запрос — оставьте 0.
MAIL_USE_PHP_MAIL=0

# Resend.com — рекомендуется (100 писем/день бесплатно): https://resend.com
RESEND_API_KEY=

# SMTP (альтернатива: Brevo smtp-relay.brevo.com, Gmail и т.д.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls

# Groq AI — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Web Push (Sprint 19) — сгенерируй: npx web-push generate-vapid-keys
# Затем: composer install (minishlink/web-push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.com
